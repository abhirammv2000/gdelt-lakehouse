# -------------------------------------------------------------
# Copy to .env and adjust. .env is git-ignored.
# The defaults target the LOCAL Docker stack (MinIO + DuckDB + Redpanda).
# -------------------------------------------------------------

# Runtime target: "local" uses MinIO/DuckDB; "aws" uses real S3/Snowflake.
GDELT_ENV=local

# -- Object storage (S3 / MinIO) ------------------------------
# For local MinIO these are the docker-compose defaults.
GDELT_S3_ENDPOINT_URL=http://localhost:9000
GDELT_S3_ACCESS_KEY=minioadmin
GDELT_S3_SECRET_KEY=minioadmin
GDELT_S3_REGION=us-east-1
GDELT_BRONZE_BUCKET=gdelt-bronze
GDELT_SILVER_BUCKET=gdelt-silver

# -- GDELT source feed ----------------------------------------
GDELT_BASE_URL=http://data.gdeltproject.org/gdeltv2
# Only ingest these feeds (comma-separated): export,mentions,gkg
GDELT_FEEDS=export

# -- Iceberg catalog (local: apache/iceberg-rest-fixture) ------
# Catalog backend: "rest" for the local fixture, "glue" on AWS.
GDELT_ICEBERG_CATALOG_TYPE=rest
GDELT_ICEBERG_CATALOG_URI=http://localhost:8181
GDELT_ICEBERG_WAREHOUSE=s3://gdelt-silver/warehouse

# -- Kafka / Redpanda -----------------------------------------
GDELT_KAFKA_BOOTSTRAP=localhost:19092
GDELT_KAFKA_TOPIC=gdelt.events.raw
GDELT_KAFKA_DLQ_TOPIC=gdelt.events.dlq
GDELT_KAFKA_ALERTS_TOPIC=gdelt.events.alerts
GDELT_KAFKA_CONSUMER_GROUP=gdelt-stream-consumer

# -- Warehouse (Snowflake) - only used when GDELT_ENV=aws ------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=GDELT
SNOWFLAKE_SCHEMA=GOLD

# -- OpenLineage ----------------------------------------------
OPENLINEAGE_URL=http://localhost:5000
OPENLINEAGE_NAMESPACE=gdelt-lakehouse
